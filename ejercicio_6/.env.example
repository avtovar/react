# Clave de API de Imgbb para subir las imágenes de los productos.
# Obtené tu clave en https://imgbb.com → "Acerca" → "API" → "GET API-KEY"
#
# Para usarla: copiá este archivo como .env y reemplazá el valor:
#   VITE_IMGBB_API_KEY=tu-clave-real-aca
#
# ⚠️ NUNCA subas tu .env real a GitHub (ya está excluido en el .gitignore).
VITE_IMGBB_API_KEY=TU-API-KEY